{
  "name": "plutusshield",
  "private": true,
  "version": "0.1.0",
  "description": "DeFi and smart-contract insurance for Cardano and Midnight",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --filter @plutusshield/web dev",
    "build": "pnpm --filter @plutusshield/web build",
    "build:pages": "pnpm --filter @plutusshield/web build:pages",
    "preview": "pnpm --filter @plutusshield/web preview",
    "lint": "pnpm --filter @plutusshield/web lint",
    "test": "pnpm --filter @plutusshield/sdk test && pnpm --filter @plutusshield/cardano-contracts test && pnpm --filter @plutusshield/cardano-deploy test && pnpm --filter @plutusshield/midnight-contracts test && pnpm --filter @plutusshield/oracle-relay test",
    "test:sdk": "pnpm --filter @plutusshield/sdk test",
    "test:cardano": "pnpm --filter @plutusshield/cardano-contracts test",
    "test:deploy": "pnpm --filter @plutusshield/cardano-deploy test",
    "preview:keygen": "pnpm --filter @plutusshield/cardano-deploy keygen",
    "preview:plan": "pnpm --filter @plutusshield/cardano-deploy plan",
    "cardano:preview": "pnpm --filter @plutusshield/cardano-deploy preview",
    "oracle:publish": "pnpm --filter @plutusshield/cardano-deploy oracle",
    "test:relay": "pnpm --filter @plutusshield/oracle-relay test",
    "relay:evaluate": "pnpm --filter @plutusshield/oracle-relay evaluate",
    "relay:live": "pnpm --filter @plutusshield/oracle-relay live",
    "test:midnight": "pnpm --filter @plutusshield/midnight-contracts test",
    "build:cardano": "pnpm --filter @plutusshield/cardano-contracts build",
    "compile:midnight": "pnpm --filter @plutusshield/midnight-contracts compile",
    "midnight:relay:plan": "pnpm --filter @plutusshield/midnight-contracts relay:plan"
  },
  "engines": {
    "node": ">=20"
  }
}
