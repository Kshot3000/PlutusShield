/*
 * policy-cover-v2.compact — PlutusShield private cover registry (Midnight),
 * v2: committee-gated claim resolution.
 *
 * Same registry as policy-cover.compact (v1, live on Preprod at d84c6187…),
 * except that no single assessor key can approve or reject a claim. The
 * constructor fixes a committee of three assessor commitments and a threshold
 * M (1..3, the three commitments must be distinct and non-empty). Each
 * committee member calls voteClaim(policyId, approve) proving knowledge of the
 * secret behind one committee commitment; one vote per member per claim round.
 * The claim flips to PAID when M approvals land, or back to ACTIVE (evidence
 * cleared) when M rejections land. This mirrors the Cardano exploit-cover v2
 * pool, whose Settle needs 2-of-3 committee signatures, so neither chain has a
 * single trusted claims key.
 *
 * Votes are public and attributable on purpose: the ledger records which
 * committee commitment voted which way on which claim round (claimVotes), so
 * assessor behaviour can be audited. Nothing about the holder, coverage or
 * evidence bundle is revealed beyond v1.
 *
 * Mirrors each Cardano policy NFT (by 32-byte policy id) with a private record:
 *   - the holder is a commitment to a local secret, never a raw public key
 *   - the coverage amount is a hiding commitment (persistentCommit), never public
 *   - claims carry only an evidence commitment; evidence stays off-ledger
 *
 * What a holder can prove without revealing size or identity:
 *   proveCover(policyId, minCoverage) succeeds iff the caller owns an ACTIVE
 *   policy whose committed coverage is >= minCoverage. Partners (DEXes,
 *   lending markets) can gate "insured-only" flows on this.
 *
 * Holder rotation: rotateHolder(policyId, newHolderCommitment) lets the current
 * holder move an ACTIVE policy to a new key (lost-device recovery, wallet
 * migration, private transfer) without revealing either key.
 *
 * Authorization follows the witness-commitment pattern (no ownPublicKey()):
 *   roleCommitment(sk, tag) = persistentHash("plutusshield:role:" || tag || sk)
 *
 * Evidence commitments (what fileClaim stores) follow one published scheme so an
 * assessor can check an off-ledger evidence bundle against the ledger:
 *   evidenceCommitment(digest, salt) =
 *     persistentHash("plutusshield:evidence:v1" || digest || salt)
 * where digest = SHA-256 of the canonical bundle bytes and salt is 32 random
 * bytes kept with the bundle key. packages/sdk/src/evidence.ts mirrors it.
 * fileClaim cannot check the opening (the bundle never enters a circuit); the
 * committee checks it off-ledger before voteClaim.
 *
 * Cardano binding: the Buy datum's 32-byte `midnight_commitment` is
 *   registrationCommitment(policyId, holderCommitment, coverage) =
 *     persistentHash("plutusshield:register:v1" || policyId || holder || coverage)
 * computed by the buyer's browser before signing. registerPolicy takes that
 * datum field and refuses a holder/coverage pair that doesn't open it, and the
 * stored record is public, so anyone can recompute it against the Cardano
 * datum: the issuer cannot register a holder key or coverage the buyer did not
 * commit to. packages/sdk/src/midnight.ts mirrors it.
 *
 * Status: compiles with compactc 0.31.1. Not audited.
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

export enum PolicyStatus {
  NONE,
  ACTIVE,
  CLAIM_PENDING,
  PAID,
  EXPIRED
}

export struct PolicyRecord {
  holder: Bytes<32>,
  coverage: Bytes<32>,
  expiry: Uint<64>,
  status: PolicyStatus,
  evidence: Bytes<32>,
  round: Uint<32>
}

/* ---------- public ledger ---------- */

/* Issuer = PlutusShield underwriting authority (governance-rotatable later). */
export ledger issuer: Bytes<32>;
/* Claims committee: three assessor role commitments and an approval threshold. */
export ledger assessors: Vector<3, Bytes<32>>;
export ledger threshold: Uint<8>;

/* One entry per (policy, claim round, committee member): true = approve. */
export ledger claimVotes: Map<Bytes<32>, Boolean>;
/* Running tallies per (policy, claim round). */
export ledger approvals: Map<Bytes<32>, Uint<8>>;
export ledger rejections: Map<Bytes<32>, Uint<8>>;
export ledger votesCast: Counter;
export ledger claimsRejected: Counter;

export ledger policies: Map<Bytes<32>, PolicyRecord>;
export ledger activePolicies: Counter;
export ledger claimsFiled: Counter;
export ledger claimsPaid: Counter;
export ledger coverProofs: Counter;
export ledger holderRotations: Counter;

/* ---------- private witnesses ---------- */

witness localSecretKey(): Bytes<32>;
witness coverageAmount(policyId: Bytes<32>): Uint<64>;
witness coverageSalt(policyId: Bytes<32>): Bytes<32>;

/* ---------- constructor ---------- */

constructor(committee: Vector<3, Bytes<32>>, m: Uint<8>) {
  const c = disclose(committee);
  const t = disclose(m);
  assert(t >= 1 && t <= 3, "threshold must be 1..3");
  assert(c[0] != pad(32, "") && c[1] != pad(32, "") && c[2] != pad(32, ""), "empty committee member");
  assert(c[0] != c[1] && c[0] != c[2] && c[1] != c[2], "committee members must be distinct");
  issuer = disclose(roleCommitment(localSecretKey(), issuerTag()));
  assessors = c;
  threshold = t;
}

/* ---------- helpers ---------- */

export pure circuit issuerTag(): Bytes<32> {
  return pad(32, "issuer");
}

export pure circuit holderTag(): Bytes<32> {
  return pad(32, "holder");
}

export pure circuit assessorTag(): Bytes<32> {
  return pad(32, "assessor");
}

export pure circuit roleCommitment(sk: Bytes<32>, tag: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "plutusshield:role:"),
    tag,
    sk
  ]);
}

export pure circuit evidenceTag(): Bytes<32> {
  return pad(32, "plutusshield:evidence:v1");
}

/* Hiding commitment to an evidence bundle: digest = SHA-256(canonical bundle). */
export pure circuit evidenceCommitment(bundleDigest: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    evidenceTag(),
    bundleDigest,
    salt
  ]);
}

export pure circuit registrationTag(): Bytes<32> {
  return pad(32, "plutusshield:register:v1");
}

/* What the Cardano Buy datum carries: binds policy id, holder key and coverage. */
export pure circuit registrationCommitment(
  policyId: Bytes<32>,
  holderCommitment: Bytes<32>,
  coverage: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    registrationTag(),
    policyId,
    holderCommitment,
    coverage
  ]);
}

export pure circuit coverageCommitment(amount: Uint<64>, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Uint<64>>(amount, salt);
}

circuit assertIssuer(): [] {
  assert(
    disclose(roleCommitment(localSecretKey(), issuerTag())) == issuer,
    "caller is not the issuer"
  );
}

/* Returns the caller's committee commitment; fails for anyone off the committee. */
circuit committeeMember(): Bytes<32> {
  const me = disclose(roleCommitment(localSecretKey(), assessorTag()));
  assert(
    me == assessors[0] || me == assessors[1] || me == assessors[2],
    "caller is not on the assessor committee"
  );
  return me;
}

export pure circuit voteTag(): Bytes<32> {
  return pad(32, "plutusshield:vote:v1");
}

export pure circuit tallyTag(): Bytes<32> {
  return pad(32, "plutusshield:tally:v1");
}

/* Key of one claim round: (policy id, round number). */
export pure circuit roundKey(policyId: Bytes<32>, round: Uint<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    tallyTag(),
    policyId,
    persistentHash<Uint<32>>(round)
  ]);
}

/* Key of one member's vote in one claim round. */
export pure circuit voteKey(policyId: Bytes<32>, round: Uint<32>, member: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    voteTag(),
    roundKey(policyId, round),
    member
  ]);
}

circuit assertHolder(rec: PolicyRecord): [] {
  assert(
    disclose(roleCommitment(localSecretKey(), holderTag())) == rec.holder,
    "caller does not hold this policy"
  );
}

/* ---------- lifecycle ---------- */

/*
 * Issuer registers a policy after the Cardano mint confirms.
 * holderCommitment and coverage are produced client-side by the buyer, who
 * also put registrationCommitment(policyId, holder, coverage) in the Cardano
 * policy datum. The issuer passes that datum field as cardanoCommitment and
 * the circuit refuses any holder/coverage pair that doesn't open it.
 */
export circuit registerPolicy(
  policyId: Bytes<32>,
  holderCommitment: Bytes<32>,
  coverage: Bytes<32>,
  expiry: Uint<64>,
  cardanoCommitment: Bytes<32>
): [] {
  assertIssuer();
  const id = disclose(policyId);
  assert(!policies.member(id), "policy already registered");
  assert(disclose(holderCommitment) != pad(32, ""), "empty holder commitment");
  assert(disclose(coverage) != pad(32, ""), "empty coverage commitment");
  assert(
    disclose(registrationCommitment(policyId, holderCommitment, coverage)) == disclose(cardanoCommitment),
    "registration does not match the Cardano commitment"
  );
  policies.insert(id, PolicyRecord {
    holder: disclose(holderCommitment),
    coverage: disclose(coverage),
    expiry: disclose(expiry),
    status: PolicyStatus.ACTIVE,
    evidence: pad(32, ""),
    round: 0
  });
  activePolicies.increment(1);
}

/*
 * Holder proves "I hold ACTIVE cover of at least minCoverage" for policyId.
 * Reveals nothing about the exact amount or the holder's key.
 */
export circuit proveCover(policyId: Bytes<32>, minCoverage: Uint<64>): [] {
  const id = disclose(policyId);
  assert(policies.member(id), "unknown policy");
  const rec = policies.lookup(id);
  assert(rec.status == PolicyStatus.ACTIVE, "policy not active");
  assertHolder(rec);
  const amount = coverageAmount(id);
  const salt = coverageSalt(id);
  assert(
    disclose(coverageCommitment(amount, salt)) == rec.coverage,
    "coverage opening does not match commitment"
  );
  assert(disclose(amount >= minCoverage), "coverage below requested minimum");
  coverProofs.increment(1);
}

/*
 * Current holder rotates the policy to a new holder commitment (key rotation
 * or private transfer). Only the holder field changes; coverage, expiry and
 * evidence are untouched. The old key immediately loses proveCover/fileClaim
 * and the new key gains them. The coverage opening (amount, salt) is handed to
 * the new holder off-ledger; they can check it against the public commitment.
 * Only ACTIVE policies rotate: a pending claim, a paid claim or an expired
 * policy is frozen to the holder of record.
 */
export circuit rotateHolder(policyId: Bytes<32>, newHolderCommitment: Bytes<32>): [] {
  const id = disclose(policyId);
  assert(policies.member(id), "unknown policy");
  const rec = policies.lookup(id);
  assert(rec.status == PolicyStatus.ACTIVE, "policy not transferable");
  assertHolder(rec);
  const next = disclose(newHolderCommitment);
  assert(next != pad(32, ""), "empty holder commitment");
  assert(next != rec.holder, "new holder matches current holder");
  policies.insert(id, PolicyRecord {
    holder: next,
    coverage: rec.coverage,
    expiry: rec.expiry,
    status: rec.status,
    evidence: rec.evidence,
    round: rec.round
  });
  holderRotations.increment(1);
}

/*
 * Holder files a claim; only a commitment to the evidence bundle goes on-ledger.
 * Each filing opens a fresh claim round, so votes on an earlier (rejected)
 * filing never count toward a new one.
 */
export circuit fileClaim(policyId: Bytes<32>, evidenceCommitment: Bytes<32>): [] {
  const id = disclose(policyId);
  assert(policies.member(id), "unknown policy");
  const rec = policies.lookup(id);
  assert(rec.status == PolicyStatus.ACTIVE, "policy not claimable");
  assertHolder(rec);
  assert(disclose(evidenceCommitment) != pad(32, ""), "empty evidence commitment");
  policies.insert(id, PolicyRecord {
    holder: rec.holder,
    coverage: rec.coverage,
    expiry: rec.expiry,
    status: PolicyStatus.CLAIM_PENDING,
    evidence: disclose(evidenceCommitment),
    round: (rec.round + 1) as Uint<32>
  });
  claimsFiled.increment(1);
}

/*
 * A committee member votes on a pending claim. One vote per member per round.
 * M approvals -> PAID (Cardano settles the payout with its own M-of-N Settle);
 * M rejections -> ACTIVE with the evidence cleared (the holder may re-file).
 */
export circuit voteClaim(policyId: Bytes<32>, approve: Boolean): [] {
  const me = committeeMember();
  const id = disclose(policyId);
  assert(policies.member(id), "unknown policy");
  const rec = policies.lookup(id);
  assert(rec.status == PolicyStatus.CLAIM_PENDING, "no pending claim");
  const vk = voteKey(id, rec.round, me);
  assert(!claimVotes.member(vk), "already voted on this claim");
  const ok = disclose(approve);
  claimVotes.insert(vk, ok);
  votesCast.increment(1);

  const rk = roundKey(id, rec.round);
  const yes = approvals.member(rk) ? approvals.lookup(rk) : 0 as Uint<8>;
  const no = rejections.member(rk) ? rejections.lookup(rk) : 0 as Uint<8>;
  const yes2 = ok ? (yes + 1) as Uint<8> : yes;
  const no2 = ok ? no : (no + 1) as Uint<8>;
  approvals.insert(rk, yes2);
  rejections.insert(rk, no2);

  if (yes2 >= threshold) {
    policies.insert(id, PolicyRecord {
      holder: rec.holder,
      coverage: rec.coverage,
      expiry: rec.expiry,
      status: PolicyStatus.PAID,
      evidence: rec.evidence,
      round: rec.round
    });
    claimsPaid.increment(1);
    activePolicies.decrement(1);
  } else if (no2 >= threshold) {
    policies.insert(id, PolicyRecord {
      holder: rec.holder,
      coverage: rec.coverage,
      expiry: rec.expiry,
      status: PolicyStatus.ACTIVE,
      evidence: pad(32, ""),
      round: rec.round
    });
    claimsRejected.increment(1);
  }
}

/* Issuer expires a policy past its term (mirrors Cardano expiry / burn). */
export circuit expirePolicy(policyId: Bytes<32>): [] {
  assertIssuer();
  const id = disclose(policyId);
  assert(policies.member(id), "unknown policy");
  const rec = policies.lookup(id);
  assert(rec.status == PolicyStatus.ACTIVE, "only active policies expire");
  policies.insert(id, PolicyRecord {
    holder: rec.holder,
    coverage: rec.coverage,
    expiry: rec.expiry,
    status: PolicyStatus.EXPIRED,
    evidence: rec.evidence,
    round: rec.round
  });
  activePolicies.decrement(1);
}
