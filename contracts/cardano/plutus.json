    "plutusshield/types/CoverParams": {
      "title": "CoverParams",
      "description": "Validator parameters. Applied once at deployment; there is no admin key.",
      "anyOf": [
        {
          "title": "CoverParams",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "seed",
              "description": "UTxO consumed to mint the unique pool NFT (one-shot).",
              "$ref": "#/definitions/cardano~1transaction~1OutputReference"
            },
            {
              "title": "pool_asset",
              "description": "Currency for LP capital, premiums, and payouts.",
              "$ref": "#/definitions/plutusshield~1types~1AssetClass"
            },
            {
              "title": "product",
              "$ref": "#/definitions/plutusshield~1types~1ProductTerms"
            },
            {
              "title": "oracle",
              "$ref": "#/definitions/plutusshield~1types~1OracleConfig"
            },
            {
              "title": "claim_grace_ms",
              "description": "After expiry, how long a holder still has to submit a claim for a\n trigger window that ended on or before expiry.",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "plutusshield/types/MintAction": {
      "title": "MintAction",
      "anyOf": [
        {
          "title": "InitPool",
          "description": "Mint the pool NFT once, consuming `seed`.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "ViaPool",
          "description": "Any LP-share or policy-token mint/burn. Validated by the pool spend.",
          "dataType": "constructor",
          "index": 1,
          "fields": []
        },
        {
          "title": "BurnUserTokens",
          "description": "A holder may always burn their own policy user tokens (e.g. after expiry).",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        }
      ]
    },
    "plutusshield/types/OracleConfig": {
      "title": "OracleConfig",
      "description": "Which oracle feeds are trusted. A feed is a UTxO, used as a reference\n input, that holds exactly one token `policy_id.<feed name>` where the feed\n name is in `feeds`. `quorum` distinct feeds must agree.",
      "anyOf": [
        {
          "title": "OracleConfig",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "policy_id",
              "$ref": "#/definitions/cardano~1assets~1PolicyId"
            },
            {
              "title": "feeds",
              "$ref": "#/definitions/List<cardano~1assets~1AssetName>"
            },
            {
              "title": "quorum",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "plutusshield/types/PolicyDatum": {
      "title": "PolicyDatum",
      "description": "State of one policy, carried by the UTxO holding its reference token.",
      "anyOf": [
        {
          "title": "PolicyDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "policy_id",
              "description": "32 bytes: blake2b_256(cbor(pool output reference consumed at purchase)).\n Same id the Midnight `policy-cover` registry is keyed by.",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "product_id",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "coverage",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "premium",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "start",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "expiry",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "trigger",
              "$ref": "#/definitions/plutusshield~1types~1Trigger"
            },
            {
              "title": "midnight_commitment",
              "description": "32-byte Midnight coverage commitment (persistentCommit(amount, salt)),\n mirrored into `policy-cover.compact` by `registerPolicy`.",
              "$ref": "#/definitions/ByteArray"
            }
          ]
        }
      ]
    },
    "plutusshield/types/PoolAction": {
      "title": "PoolAction",
      "anyOf": [
        {
          "title": "Deposit",
          "description": "LP adds capital; LP shares minted pro rata.",
          "dataType": "constructor",
          "index": 0,
          "fields": []
        },
        {
          "title": "Withdraw",
          "description": "LP burns `shares` for their pro-rata capital, subject to the reserve rule.",
          "dataType": "constructor",
          "index": 1,
          "fields": [
            {
              "title": "shares",
              "$ref": "#/definitions/Int"
            }
          ]
        },
        {
          "title": "Buy",
          "description": "Buyer pays premium into the pool and mints a policy (ref + user token).",
          "dataType": "constructor",
          "index": 2,
          "fields": []
        },
        {
          "title": "Settle",
          "description": "Holder burns the policy and receives `coverage` from the pool.",
          "dataType": "constructor",
          "index": 3,
          "fields": []
        },
        {
          "title": "Expire",
          "description": "Anyone retires a policy after expiry + grace, unlocking its capital.",
          "dataType": "constructor",
          "index": 4,
          "fields": []
        }
      ]
    },
    "plutusshield/types/PoolDatum": {
      "title": "PoolDatum",
      "description": "State of the underwriting pool, carried by the UTxO holding the pool NFT.\n Capital is the pool asset quantity in that UTxO itself.",
      "anyOf": [
        {
          "title": "PoolDatum",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "total_shares",
              "description": "Outstanding LP share tokens.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "active_cover",
              "description": "Sum of coverage across live policies (capital locked against claims).",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "plutusshield/types/ProductTerms": {
      "title": "ProductTerms",
      "description": "One product line per deployment. Mirrors `packages/sdk` PRODUCTS + quote\n engine constants, converted to integer basis points.",
      "anyOf": [
        {
          "title": "ProductTerms",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "product_id",
              "description": "\"depeg\" | \"exploit\" | \"sla\" (matches SDK ProductId)",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "trigger",
              "$ref": "#/definitions/plutusshield~1types~1Trigger"
            },
            {
              "title": "base_rate_bps",
              "description": "Base annual premium rate, e.g. 200 = 2.00%.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "risk_mult_bps",
              "description": "Risk-tier multiplier for the covered asset: A 8_000, B 10_000, C 15_000.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "min_days",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_days",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "min_premium",
              "description": "Premium floor in pool-asset base units.",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_single_policy_bps",
              "description": "One policy can take at most this share of pool capital (1_000 = 10%).",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "max_utilization_bps",
              "description": "Active cover can never exceed this share of capital (9_000 = 90%).",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    },
    "plutusshield/types/Trigger": {
      "title": "Trigger",
      "description": "The objective condition a parametric policy pays out on.\n\n Depeg example: `covered_asset` = \"USDM\", `threshold_bps` = 9_500 (price\n below 0.95 of peg), `window_ms` = 86_400_000 (for at least 24h).",
      "anyOf": [
        {
          "title": "Trigger",
          "dataType": "constructor",
          "index": 0,
          "fields": [
            {
              "title": "covered_asset",
              "$ref": "#/definitions/ByteArray"
            },
            {
              "title": "threshold_bps",
              "$ref": "#/definitions/Int"
            },
            {
              "title": "window_ms",
              "$ref": "#/definitions/Int"
            }
          ]
        }
      ]
    }
